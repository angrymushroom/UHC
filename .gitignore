# Publish only the reviewed project files and the fixed, sanitized sample bundle.
# Local data and environments remain usable but are not part of Git uploads.
/*
!/.gitignore
!/README.md
!/config.toml
!/pyproject.toml
!/requirements.txt
!/src/
!/sql/
!/dashboard/
!/tests/
!/sample_data/
!/assets/

/assets/*
!/assets/service-price-dispersion.png

/src/*
!/src/*.py
/sql/*
!/sql/0[1-3]_*.sql
/dashboard/*
!/dashboard/streamlit_app.py
!/dashboard/environment.yml
/tests/*
!/tests/test_ingest.py
/sample_data/*
!/sample_data/indexes.jsonl.gz
!/sample_data/downloads.jsonl.gz
!/sample_data/pricing.jsonl.gz
!/sample_data/selected_indexes.csv
!/sample_data/selected_pricing.csv

**/__pycache__/
**/.DS_Store
*.py[cod]
*.log
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.pptx
*.ppt
*.keynote
AGENTS.md
